{
  "collectionName": "components_atoms_inputs",
  "info": {
    "displayName": "Inputs"
  },
  "options": {
    "privateAttributes": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "checkbox",
        "date",
        "email",
        "file",
        "hidden",
        "radio",
        "range",
        "reset",
        "search",
        "submit",
        "tel",
        "text",
        "textarea",
        "terms",
        "url"
      ]
    },
    "checkboxes": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "checkbox"
          ]
        }
      },
      "component": "atoms.multiple-checkboxes",
      "repeatable": true,
      "required": true,
      "min": 1
    },
    "email": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "email"
          ]
        }
      },
      "component": "form.email",
      "repeatable": false,
      "required": false
    },
    "reset": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "reset"
          ]
        }
      },
      "component": "form.reset-button",
      "repeatable": false
    }
  },
  "config": {}
}
